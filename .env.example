# Moltbot Configuration

# Gateway / Nexus Tool Bridge (required for Nexus integration)
# Keep OPENCLAW_GATEWAY_TOKEN and NEXUS_OPENCLAW_API_KEY aligned with
# Nexus server OPENCLAW_API_KEY unless you intentionally split secrets.
OPENCLAW_GATEWAY_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_TOKEN=sk-openclaw-local
NEXUS_API_URL=http://host.docker.internal:3001
NEXUS_OPENCLAW_API_KEY=sk-openclaw-local

# API Keys
# OpenAI Codex / GPT
OPENAI_API_KEY=

# MiniMax M2.1
MINIMAX_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini / AI Studio
GEMINI_API_KEY=

# Kimi CLI
KIMI_API_KEY=

# OpenCode AI
OPENCODE_API_KEY=

# Optional Integrations
GOOGLE_MAPS_API_KEY=
NANOBANANA_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=

# Coolify / Deployment
PORT=18790
NODE_ENV=production

# --- Sandbox Configuration ---
# Sandbox networking: "none" (air-gapped) or "bridge" (outbound internet)
# Set to "bridge" so user-session sandbox containers have outbound internet access
# (required for git clone, npm install, etc.)
OPENCLAW_AGENTS_DEFAULTS_SANDBOX_DOCKER_NETWORK=bridge

# Workspace access: "none" | "ro" (read-only) | "rw" (read-write)
# For agent runtimes with exclusive access, use "rw" for full file permissions
# For shared or restricted access, use "ro" or "none"
OPENCLAW_AGENTS_DEFAULTS_SANDBOX_WORKSPACEACCESS=rw

# --- Optional / Advanced ---

# Public Access (Cloudflare Tunnel)
CF_TUNNEL_TOKEN=

# Deployment (Vercel)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Git Operations (GitHub)
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_EMAIL=
